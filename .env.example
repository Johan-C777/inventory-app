# Local con SQLite (provider = "sqlite" en prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Producción con Postgres: DATABASE_URL="postgresql://user:pass@host:5432/db"

# Login. Sin estas dos variables nadie puede entrar (falla cerrado).
ADMIN_PASSWORD=""
AUTH_SECRET=""          # openssl rand -base64 48

# Avisos de préstamos vencidos (opcional). Webhook de Discord o compatible.
NOTIFY_WEBHOOK_URL=""
CRON_SECRET=""          # Vercel lo envía como Bearer al cron

NEXT_PUBLIC_APP_TZ="America/Bogota"
